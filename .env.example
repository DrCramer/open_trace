# Скопируйте в .env (scripts/install.sh делает это сам).
# Адрес, на котором сайт слушает на сервере. 127.0.0.1 — только сам сервер.
WEB_BIND_IP=127.0.0.1
# Порт сайта на хосте.
WEB_PORT=8765
# Имена или IP, по которым сайт открывают в браузере (без порта), через запятую.
# Для доступа из локальной сети добавьте IP/имя сервера, например:
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.16
ALLOWED_HOSTS=localhost,127.0.0.1
TZ=Europe/Moscow
# Число процессов анализа. Пусто — авто (до 4, по числу ядер сервера), 1 — один процесс.
WORKERS=
# 1 — собрать Rust-ядро (ускоряет только этап расчёта пиков), 0 — только Python.
WITH_RUST_CORE=1
# Владелец каталога runtime/ (заполняется install.sh).
OPENTRACE_UID=1000
OPENTRACE_GID=1000
