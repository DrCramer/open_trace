# Byte-exact files: the web UI is served as stored and compared by the HTTP golden tests; golden corpora and
# shipped data are hashed. Keep LF on every platform (Windows checkouts with core.autocrlf=true would add CR).
*.rs            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.js            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.xml           text eol=lf
*.txt           text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
resources/**    text=auto eol=lf
*.gz            binary
*.fsa           binary
*.ab1           binary
*.png           binary
*.ico           binary
*.icns          binary
# Windows scripts keep CRLF.
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf
