{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTrace Desktop",
  "mainBinaryName": "opentrace-desktop",
  "version": "0.1.0",
  "identifier": "org.opentrace.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "publisher": "OpenTrace",
    "category": "Utility",
    "shortDescription": "STR electropherogram analysis (research use only)",
    "longDescription": "OpenTrace Desktop: local STR electropherogram analysis with the OpenTrace Rust core, optional connection to an OpenTrace Server. Research software, not validated for diagnostic or forensic casework.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../../resources/web/": "resources/web/",
      "../../../resources/data/": "resources/data/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
